# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# Gemini API keys are optional but required when using the Gemini backend.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY_2=optional-secondary-key
# GEMINI_API_KEY_3=optional-tertiary-key
# GEMINI_API_KEY_4=optional-quaternary-key

# The paper's full-system configuration uses OpenAI GPT-5.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5

# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
