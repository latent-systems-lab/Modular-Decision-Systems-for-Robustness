# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# Gemini API keys are optional but required when using the Gemini backend.
GEMINI_API_KEY=your-gemini-api-key

# Choose the LLM backend: set to "gemini" (default) or "gpt" for OpenAI.
LLM_PROVIDER=gemini
# Override the default model if needed (e.g., gpt-4o-mini, gemini-2.5-flash)
# LLM_MODEL=

# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key
